# Local Mongo used by revibed-archiver (export-tracks.js reads from it directly)
MONGODB_URI=mongodb://127.0.0.1:27017

# MEGA S4 (S3-compatible object storage) - fill these in from the MEGA S4 dashboard
S4_ENDPOINT=https://s3.<region>.s4.mega.io
S4_REGION=<region>
S4_ACCESS_KEY=
S4_SECRET_KEY=
S4_BUCKET=skyharp-3d-audio

# "true" if the bucket/objects are publicly readable and audioUrl can point
# straight at S4; "false" if reads must go through a signed URL minted by
# the backend later (audioKey gets stored instead of audioUrl in that case).
S4_PUBLIC_READ=false
