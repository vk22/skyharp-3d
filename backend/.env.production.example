# Used by docker-compose.yml's backend service (env_file: ./backend/.env.production).
# Copy to backend/.env.production ON THE VPS ONLY - never commit the real file,
# never paste the real values into chat.

PORT=4001
ALLOWED_ORIGIN=https://your-domain.example

# "mongo" is the docker-compose service name, resolved over the internal network.
MONGODB_URI=mongodb://mongo:27017
DATABASE_NAME=skyharp3d

JWT_SECRET=change-me-to-a-long-random-string

# Same MEGA S4 bucket that data-pipeline/upload-to-s4.js uploaded audio to
S4_ENDPOINT=https://s3.<region>.s4.mega.io
S4_REGION=<region>
S4_ACCESS_KEY=
S4_SECRET_KEY=
S4_BUCKET=

MANIFEST_PATH=./data/manifest.json
