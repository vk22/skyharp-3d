PORT=4001
ALLOWED_ORIGIN=http://localhost:5174

MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=skyharp3d

JWT_SECRET=change-me-to-a-long-random-string

# Same MEGA S4 bucket that data-pipeline/upload-to-s4.js uploaded audio to
S4_ENDPOINT=https://s3.<region>.s4.mega.io
S4_REGION=<region>
S4_ACCESS_KEY=
S4_SECRET_KEY=
S4_BUCKET=

# Path to the manifest.json produced by data-pipeline (copy it into backend/data/)
MANIFEST_PATH=./data/manifest.json
